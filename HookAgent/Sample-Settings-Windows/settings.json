{
  "_readme": [
    "Sample .claude/settings.json for Windows: registers HookAgent for 31 of the 33 Claude Code hook events (as of Claude Code 2.1.318)",
    "and forwards them to the CodingAgentExplorer dashboard (http://localhost:5000).",
    "",
    "Setup:",
    "  1. Copy the Published\\HookAgent\\ folder into your working directory (e.g. C:\\MyProject\\HookAgent\\).",
    "  2. Copy this file to .claude\\settings.json inside that same working directory.",
    "  3. Start CodingAgentExplorer (dotnet run), then run 'claude' from your working directory.",
    "",
    "Note: on Windows, Claude Code runs hook commands with Git Bash, or with PowerShell when Git Bash is not installed.",
    "Forward slashes in the command path work in both: HookAgent/HookAgent.exe",
    "The command path is relative: it resolves from wherever you run 'claude'.",
    "If the dashboard is not running, HookAgent exits silently with code 0.",
    "",
    "Left out on purpose: WorktreeCreate and WorktreeRemove (the hook replaces git's worktree handling, so HookAgent would break it).",
    "FileChanged watches only the literal file names in its matcher (here .env and .envrc); change them to the files you care about. Remove an entry below if your Claude Code version does not know the event.",
    "MessageDisplay fires while text streams, so it runs with async: true. Add async: true to any entry if you only observe and do not care about exact ordering."
  ],

  "hooks": {

    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "SubagentStart": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "Notification": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "ConfigChange": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "TeammateIdle": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "TaskCompleted": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "Setup": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "UserPromptExpansion": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "PermissionDenied": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "PostToolBatch": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "MessageDisplay": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": true }]
      }
    ],

    "TaskCreated": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "StopFailure": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "InstructionsLoaded": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "CwdChanged": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "DirectoryAdded": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "PostCompact": [
      {
        "hooks": [{ "type": "command", "command": "HookAgent/HookAgent.exe", "async": false }]
      }
    ],

    "PreModelSwitch": [
